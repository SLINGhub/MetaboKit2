{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaboKit GUI",
  "version": "0.3.1",
  "identifier": "app.metabokit.dda",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MetaboKit GUI",
        "width": 1320,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "DDA and DIA metabolomics processing",
    "longDescription": "Native DDA and DIA metabolomics: mzML parsing, feature detection, spectral library scoring, quantification and chromatogram visualization.",
    "resources": { "../metabokit-dia/LICENSE": "licenses/MetaboKit-DIA-LICENSE.txt" },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": true
    }
  }
}
